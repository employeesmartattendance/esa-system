# ── ESA Backend Environment Variables ──

# ── Server ──
PORT=3000
NODE_ENV=development
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES=30d

# ── MongoDB ──
MONGODB_URI=mongodb://localhost:27017/esa_db

# ── Frontend / CORS ──
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://esasystem.online
BACKEND_PUBLIC_URL=

# ── Email (SMTP) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=ESA System
SMTP_FROM_EMAIL=

# ── Email (Resend — alternative, works on Render) ──
RESEND_API_KEY=

# ── Cloudinary (optional — for persistent image storage) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=esa

# ── Uploads (fallback if Cloudinary is not set) ──
UPLOADS_DIR=./uploads

# ── CompreFace Biometric Verification ──
# Required if biometric_enabled is true in school settings.
# See README for CompreFace Docker setup instructions.
COMPRE_FACE_URL=http://localhost:8000
COMPRE_FACE_API_KEY=your-compreface-api-key
COMPRE_FACE_SERVICE_KEY=your-recognition-service-key
# Similarity threshold (0.00 - 1.00). Default: 0.90
# >= 0.95 : immediate pass
# 0.90-0.94 : ask to retry
# < 0.90 : reject
COMPRE_FACE_THRESHOLD=0.90
