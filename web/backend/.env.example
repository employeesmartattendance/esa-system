# ESA Backend Configuration

# ── Server & Database ──
PORT=3000
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/esa
JWT_SECRET=your_jwt_secret_key_change_me
JWT_EXPIRES=30d

# ── Frontend & CORS ──
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://yourdomain.com
BACKEND_PUBLIC_URL=http://localhost:3000

# ── Email (Nodemailer SMTP) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=ESA System
SMTP_FROM_EMAIL=noreply@esasystem.com

# ── Email (Resend API - alternative to SMTP) ──
RESEND_API_KEY=re_your_resend_key

# ── File Uploads (Cloudinary) ──
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
UPLOADS_DIR=./uploads

# ── Face Recognition Biometric Configuration ──
# Server-side face detection + embedding + cosine similarity (@vladmandic/face-api).
# Model weights are downloaded automatically on `npm install` — see
# backend/scripts/download-face-models.js.

# Similarity threshold for face verification (0-1)
# Higher = stricter matching, lower = more permissive
FACE_SIMILARITY_THRESHOLD=0.90

# Retry suggestion threshold (shown when similarity is between retry and similarity threshold)
FACE_RETRY_THRESHOLD=0.85

# Minimum face-detection confidence to accept (0-1)
FACE_MIN_DETECTION_SCORE=0.5

# Per-request face-detection timeout in milliseconds.
# 0 = disabled/unlimited (recommended on slow/free-tier hosts, so a slow
# cold start never causes a spurious "verification failed"). Set a positive
# number (e.g. 30000) if you want to cap how long a single capture can take.
FACE_TIMEOUT_MS=0

# ── Other ──
NODE_ENV=development
